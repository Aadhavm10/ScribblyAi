# Copy this file to secrets.yaml and fill in your values
# DO NOT commit secrets.yaml to version control!
apiVersion: v1
kind: Secret
metadata:
  name: scribbly-secrets
  namespace: scribbly
type: Opaque
stringData:
  POSTGRES_USER: "scribbly"
  POSTGRES_PASSWORD: "<your-postgres-password>"
  DATABASE_URL: "postgresql://scribbly:<password>@postgres-service:5432/scribbly"
  JWT_SECRET: "<your-jwt-secret>"
  GOOGLE_CLIENT_ID: "<your-google-client-id>"
  GOOGLE_CLIENT_SECRET: "<your-google-client-secret>"
  ELASTICSEARCH_URL: "<your-elasticsearch-url>"
  ELASTICSEARCH_API_KEY: "<your-elasticsearch-api-key>"
  TOKEN_ENCRYPTION_KEY: "<your-token-encryption-key>"
